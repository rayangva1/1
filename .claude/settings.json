{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.*.local)",
      "Read(**/*.env.local)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.n8n/**)",
      "Read(~/pokeshop-jetons/**)",
      "Read(//etc/pokeshop/**)",
      "Read(//run/secrets/**)",
      "Read(//proc/*/environ)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/*.env)",
      "Edit(**/*.env.local)",
      "Edit(./secrets/**)",
      "Edit(**/secrets/**)",
      "Edit(//etc/pokeshop/**)",
      "Edit(~/pokeshop-jetons/**)",
      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export -p)",
      "Bash(declare -x)",
      "Bash(declare -p:*)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(less .env:*)",
      "Bash(more .env:*)",
      "Bash(source .env:*)",
      "Bash(. .env:*)",
      "Bash(cat secrets/:*)",
      "Bash(cat /proc/:*)",
      "Bash(cat /etc/pokeshop/:*)",
      "Bash(cat ~/pokeshop-jetons/:*)",
      "Bash(docker compose config:*)",
      "Bash(docker-compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(docker exec:*)"
    ]
  }
}
