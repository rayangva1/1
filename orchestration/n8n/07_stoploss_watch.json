      "id": "52877880-76bb-5e55-a510-a0ed2d27f2b7",
      "name": "État du stop-loss (GET /stoploss/status)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
